  overflow: hidden;
  border-left: 1px solid rgba(255, 255, 255, 0.32);
  background: #0b1620;
  box-shadow: -18px 0 46px rgba(0, 0, 0, 0.35);
  pointer-events: auto;
  transition: width 220ms ease;
}

.multiview-map-panel--split {
  width: 44%;
}

.multiview-map-panel--full {
  width: 100%;
  border-left: 0;
}

.multiview-map {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.multiview-mode-bar {
  position: fixed;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 90;
  display: flex;
