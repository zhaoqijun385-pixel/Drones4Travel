<template>
  <div style="position: relative; width: 100%; height: 100vh;">
    <div id="cesiumContainer" style="width: 100%; height: 100%;"></div>

    <!-- 控制面板 -->
    <div class="control-panel">
      <h3>🌍 旅游观测任务</h3>
      <div class="input-group">
        <input v-model="place" placeholder="输入地点名称" @input="search" />
        <div v-if="suggestions.length" class="suggestions">
          <div v-for="p in suggestions" :key="p.id" @click="selectPlace(p)">{{ p.name }}</div>
        </div>
      </div>
      <div class="params">
        <label>半径 <input v-model.number="radius" type="number" step="10" /> m</label>
        <label>高度 <input v-model.number="altitude" type="number" step="10" /> m</label>
      </div>
      <div class="actions">
        <button @click="startMission" :disabled="!selected || running">🚀 开始观测</button>
        <button v-if="running" @click="stopMission" class="stop">⏹ 停止</button>
      </div>
      <div v-if="waypoints.length" class="progress">
        <span>📍 {{ targetName }}</span>
        <span>进度: {{ photoCount }} / {{ waypoints.length }}</span>
      </div>
    </div>

    <!-- 底部截图展示 -->
    <div v-if="photos.length" class="photo-strip">
      <div v-for="(p, i) in photos" :key="i" class="photo-item">
        <img :src="p" />
        <span>点 {{ i+1 }}</span>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, onMounted, onUnmounted } from 'vue';
import * as Cesium from 'cesium';
import {
  resolveTourismTarget,
  searchTourismPlaces,
  buildTourismObservationPoints,
} from '@shared-composables/tourismObservationPlanner.js';

// --- 状态 ---
const viewer = ref(null);
const place = ref('');
const selected = ref(null);
const suggestions = ref([]);
const radius = ref(180);
const altitude = ref(80);
const running = ref(false);
const targetName = ref('');
const waypoints = ref([]);
const photoCount = ref(0);
const photos = ref([]);

let droneEntity = null;
let markerEntities = [];
let pathEntity = null;
let animFrame = null;
let animStartTime = 0;
let totalDuration = 0;
let currentIndex = 0;

// --- 搜索 ---
function search() {
  if (!place.value.trim()) { suggestions.value = []; return; }
  suggestions.value = searchTourismPlaces(place.value, 6);
}
function selectPlace(p) {
  selected.value = p;
  place.value = p.name;
  suggestions.value = [];
}

// --- 开始任务 ---
function startMission() {
  if (!selected.value || running.value) return;
  const target = resolveTourismTarget(selected.value.name);
  if (!target) { alert('无法解析地点'); return; }

  const pts = buildTourismObservationPoints(target, {
    radiusM: radius.value,
    minAltM: altitude.value,
    photoCount: 5,
  });
  if (pts.length < 2) { alert('生成观测点失败'); return; }
  const obsPoints = pts.slice(1);

  running.value = true;
  targetName.value = target.name;
  waypoints.value = obsPoints;
  photoCount.value = 0;
  photos.value = [];

  clearEntities();

  viewer.value.camera.flyTo({
    destination: Cesium.Cartesian3.fromDegrees(target.lon, target.lat, 1000),
    orientation: { heading: 0, pitch: Cesium.Math.toRadians(-45), roll: 0 },
    duration: 2.5,
  });

  viewer.value.entities.add({
    position: Cesium.Cartesian3.fromDegrees(target.lon, target.lat, 0),
    point: { color: Cesium.Color.LIME, pixelSize: 20 },
    label: {
      text: target.name,
      font: '18px sans-serif',
      fillColor: Cesium.Color.WHITE,
      outlineColor: Cesium.Color.BLACK,
      outlineWidth: 2,
      verticalOrigin: Cesium.VerticalOrigin.BOTTOM,
      pixelOffset: new Cesium.Cartesian2(0, -20),
    },
  });

  const positions = [];
  obsPoints.forEach((p, i) => {
    const pos = Cesium.Cartesian3.fromDegrees(p.lon, p.lat, p.alt);
    positions.push(pos);
    const marker = viewer.value.entities.add({
      position: pos,
      point: { color: Cesium.Color.YELLOW, pixelSize: 14 },
      label: {
        text: `📷 ${i+1}`,
        font: '16px sans-serif',
        fillColor: Cesium.Color.WHITE,
        outlineColor: Cesium.Color.BLACK,
        outlineWidth: 2,
        verticalOrigin: Cesium.VerticalOrigin.BOTTOM,
        pixelOffset: new Cesium.Cartesian2(0, -15),
      },
    });
    markerEntities.push(marker);
  });

  pathEntity = viewer.value.entities.add({
    polyline: {
      positions: positions,
      width: 2,
      material: new Cesium.PolylineGlowMaterialProperty({
        glowPower: 0.2,
        color: Cesium.Color.CYAN,
      }),
      arcType: Cesium.ArcType.GEODESIC,
    },
  });

  const startPos = Cesium.Cartesian3.fromDegrees(target.lon, target.lat, 150);
  droneEntity = viewer.value.entities.add({
    position: startPos,
    ellipsoid: { radii: new Cesium.Cartesian3(12, 12, 6), material: Cesium.Color.CYAN },
    label: { text: '🛸', font: '24px sans-serif', verticalOrigin: Cesium.VerticalOrigin.BOTTOM, pixelOffset: new Cesium.Cartesian2(0, -10) },
  });

  currentIndex = 0;
  animStartTime = performance.now();
  totalDuration = obsPoints.length * 4000;
  if (animFrame) cancelAnimationFrame(animFrame);
  animateDrone();
}

function stopMission() {
  running.value = false;
  if (animFrame) cancelAnimationFrame(animFrame);
  clearEntities();
  waypoints.value = [];
  photos.value = [];
  photoCount.value = 0;
}

function animateDrone() {
  if (!running.value) return;
  const elapsed = performance.now() - animStartTime;
  const progress = Math.min(elapsed / totalDuration, 1);
  const totalPoints = waypoints.value.length;
  const index = Math.min(Math.floor(progress * totalPoints), totalPoints - 1);

  if (index >= 0 && index < waypoints.value.length) {
    const wp = waypoints.value[index];
    const pos = Cesium.Cartesian3.fromDegrees(wp.lon, wp.lat, wp.alt);
    if (droneEntity) droneEntity.position = pos;

    if (index > currentIndex) {
      currentIndex = index;
      photoCount.value = index + 1;
      const canvas = viewer.value.scene.canvas;
      const dataUrl = canvas.toDataURL('image/png');
      photos.value.push(dataUrl);
      if (markerEntities[index]) {
        markerEntities[index].point.color = Cesium.Color.LIME;
      }
    }
  }

  if (progress < 1) {
    animFrame = requestAnimationFrame(animateDrone);
  } else {
    running.value = false;
    photoCount.value = waypoints.value.length;
    if (photos.value.length < waypoints.value.length) {
      const canvas = viewer.value.scene.canvas;
      const dataUrl = canvas.toDataURL('image/png');
      photos.value.push(dataUrl);
    }
    markerEntities.forEach((m) => { m.point.color = Cesium.Color.LIME; });
  }
}

function clearEntities() {
  if (viewer.value) viewer.value.entities.removeAll();
  markerEntities = [];
  droneEntity = null;
  pathEntity = null;
}

// --- 初始化 Cesium ---
onMounted(async () => {
  const container = document.getElementById('cesiumContainer');

  // 尝试读取 Google API Key
  let googleKey = '';
  try {
    const res = await fetch('/config.json');
    if (res.ok) {
      const config = await res.json();
      googleKey = config.googleApiKey || '';
    }
  } catch {
    // 忽略
  }

  // 影像提供者
  const imageryProvider = googleKey
    ? new Cesium.UrlTemplateImageryProvider({
        url: `https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}&key=${googleKey}`,
        subdomains: ['mt1', 'mt2', 'mt3'],
        maximumLevel: 20,
      })
    : new Cesium.UrlTemplateImageryProvider({
        url: 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
        subdomains: ['a', 'b', 'c'],
        maximumLevel: 19,
      });

  viewer.value = new Cesium.Viewer(container, {
    imageryProvider,
    terrainProvider: Cesium.Terrain.fromWorldTerrain(),
    baseLayerPicker: false,
    geocoder: false,
    infoBox: false,
    timeline: false,
    animation: false,
    shouldAnimate: true,
  });

  viewer.value.scene.renderError.addEventListener((error) => {
    console.warn('[Cesium] Render error ignored:', error);
  });

  window.cesiumViewer = viewer.value;

  viewer.value.camera.setView({
    destination: Cesium.Cartesian3.fromDegrees(116.4, 39.9, 5000),
    orientation: { heading: 0, pitch: Cesium.Math.toRadians(-30), roll: 0 },
  });
});

onUnmounted(() => {
  if (animFrame) cancelAnimationFrame(animFrame);
  if (viewer.value) viewer.value.destroy();
});
</script>

<style scoped>
.control-panel {
  position: absolute;
  top: 80px;
  left: 20px;
  z-index: 100;
  background: rgba(0,0,0,0.85);
  padding: 16px;
  border-radius: 8px;
  width: 280px;
  color: #fff;
  font-family: sans-serif;
  box-shadow: 0 4px 20px rgba(0,0,0,0.5);
}
.control-panel h3 { margin: 0 0 8px 0; }
.input-group { position: relative; }
.input-group input {
  width: 100%;
  padding: 6px;
  border-radius: 4px;
  border: 1px solid #555;
  background: #222;
  color: #fff;
}
.suggestions {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: #1a1a1a;
  border-radius: 4px;
  max-height: 120px;
  overflow-y: auto;
  z-index: 10;
}
.suggestions div {
  padding: 4px 8px;
  cursor: pointer;
  border-bottom: 1px solid #333;
}
.suggestions div:hover { background: #333; }
.params {
  display: flex;
  gap: 8px;
  margin-top: 8px;
}
.params label {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 0.8rem;
}
.params input {
  width: 60px;
  background: #222;
  color: #fff;
  border: 1px solid #555;
  border-radius: 4px;
  padding: 2px;
}
.actions {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-top: 8px;
}
.actions button {
  padding: 8px;
  background: #2b6cff;
  color: #fff;
  border: none;
  border-radius: 4px;
  font-weight: 600;
  cursor: pointer;
}
.actions button:disabled { opacity: 0.5; cursor: not-allowed; }
.actions .stop { background: #d43; }
.progress {
  margin-top: 8px;
  font-size: 0.9rem;
  display: flex;
  justify-content: space-between;
}
.photo-strip {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 80;
  background: rgba(0,0,0,0.8);
  padding: 8px 16px;
  border-radius: 8px;
  display: flex;
  gap: 6px;
  max-width: 80vw;
  overflow-x: auto;
}
.photo-item {
  flex: 0 0 120px;
  text-align: center;
}
.photo-item img {
  width: 120px;
  height: 80px;
  object-fit: cover;
  border-radius: 4px;
  border: 1px solid #888;
}
.photo-item span {
  color: #aaa;
  font-size: 0.6rem;
  display: block;
}
</style>
